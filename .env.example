DEBUG=True
SECRET_KEY=change-me-in-real-envs

ENTRA_TENANT_ID=<directory tenant id>
ENTRA_CLIENT_ID=<application client id>
ENTRA_CLIENT_SECRET=<client secret value>
ENTRA_AUTHORITY=https://<tenant-subdomain>.ciamlogin.com/<tenant-id>
ENTRA_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
FRONTEND_POST_LOGIN_URL=http://localhost:3000/
FRONTEND_POST_LOGOUT_URL=http://localhost:3000/

# Only needed if admin-created users should also get their Entra identity
# created automatically (see ENTRA_PORTAL_SETUP.md §5b). Your tenant's
# default domain, e.g. contoso.onmicrosoft.com.
ENTRA_CIAM_DOMAIN=

# Backend's own base URL — used to build the sign-in link in the
# account-setup email.
BACKEND_BASE_URL=http://localhost:8000

# Account-setup emails. Leave EMAIL_HOST blank locally — emails print to
# the console instead of requiring a real mail server. Set these for real
# before go-live.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@yourdomain.com
